generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum GameMode {
  MANTRA
  CLASSIC
}

// ✅ Nuovo: gruppi giocatore (per la tua select)
enum PlayerGroup {
  TOP
  SEMITOP
  JOLLY
  OTTIMO_TITOLARE
  BUON_TITOLARE
  DA_VOTO
  EVITABILE
}

// ✅ Nuovo: stato "sicuro / probabile / no"
enum CertaintyLevel {
  NONE
  PROBABLE
  SURE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String?
  role          Role     @default(USER)

  emailVerified Boolean  @default(false)
  gameMode      GameMode @default(MANTRA)

  team          Team?
  prediction    UserPrediction?

  // ✅ opzionale ma consigliato: relazione note svincolati
  freeAgentNotes FreeAgentNote[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Player {
  id          String @id @default(cuid())
  extId       Int    @unique
  name        String

  // ✅ Primario (Mantra): string (es. "Por", "Dd", "Ds", "W", "A", "Pc", ...)
  roleMantra  String

  // ✅ Secondario (Classic): string (es. "P","D","C","A")
  roleClassic String?

  team        String
  price       Int    @default(0)

  // ✅ Nuovi campi per "listone avanzato"
  group       PlayerGroup?       // selezione manuale (Top, SemiTop, ...)
  rigorista   CertaintyLevel     @default(NONE) // NONE / PROBABLE / SURE
  calciPiazzati CertaintyLevel   @default(NONE) // NONE / PROBABLE / SURE

  // ✅ Possibile Spesa (formula dopo): la salviamo già come numero (modificabile)
  possibleSpend Int?             // null finché non calcolata/assegnata

  teams       TeamPlayer[]
  stats       MatchdayStat[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roleMantra])
  @@index([roleClassic])
  @@index([team])
  @@index([name])

  // ✅ indici utili per filtri/ricerche nella tabella listone
  @@index([group])
  @@index([rigorista])
  @@index([calciPiazzati])
}

model Team {
  id        String @id @default(cuid())
  name      String

  ownerId   String @unique
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  players   TeamPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamPlayer {
  id          String @id @default(cuid())
  teamId      String
  playerExtId Int

  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player      Player @relation(fields: [playerExtId], references: [extId], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([teamId, playerExtId])
  @@index([playerExtId])
  @@index([teamId])
}

model MatchdayStat {
  id        String @id @default(cuid())
  matchday  Int
  playerId  String

  voteRaw   String?
  vote      Float?

  gf        Int @default(0)
  gs        Int @default(0)
  rp        Int @default(0)
  rs        Int @default(0)
  rf        Int @default(0)
  au        Int @default(0)
  amm       Int @default(0)
  esp       Int @default(0)
  ass       Int @default(0)

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, matchday])
  @@index([matchday])
  @@index([playerId])
}

model UserPrediction {
  id        String   @id @default(cuid())
  userId    String   @unique
  text      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SerieACalendarMatch {
  id        String   @id @default(cuid())
  season    String
  matchday  Int
  date      DateTime?
  location  String?
  homeTeam  String
  awayTeam  String
  result    String?

  createdAt DateTime @default(now())

  @@unique([season, matchday, homeTeam, awayTeam])
  @@index([season, matchday])
}

model FreeAgentNote {
  id        String   @id @default(cuid())
  userId    String
  playerKey Int      // extId = valore della colonna "#"
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playerKey])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
